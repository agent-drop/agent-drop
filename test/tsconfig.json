{
	"extends": "../tsconfig.json",
	"compilerOptions": {
		// The suite runs under Bun, not the Workers runtime, so it needs Bun's
		// globals on top of the worker types the code under test is written
		// against. Kept in a separate project so these never leak into `src/`.
		"types": ["bun-types", "node"]
	},
	"include": ["**/*", "../src/**/*", "../worker-configuration.d.ts"]
}
