# Agent Drop -- environment variables
# Copy to `.env` and fill in real values. `.env` is gitignored; never commit it.
# The secrets below (admin key, R2, AWS, Google client id) are also set as
# Wrangler secrets on the Worker (`wrangler secret put <NAME>`). The deployment
# identity block is NOT: the build injects it into the generated Worker config.
# API_KEY is CLI-only and never reaches the Worker.

# --- Deployment identity (single source of truth) ---
# The Cloudflare Vite plugin's config hook (scripts/deploy-identity.ts) writes
# these into the generated wrangler.json, and `bun run deploy` refuses a build
# that disagrees with this file. The committed wrangler.toml keeps placeholders.
# The HTTP host the Worker serves from. Route becomes "$DOMAIN/*". May be a
# subdomain (drop.example.com) when the apex is already serving something else.
DOMAIN=example.com
# A separate hostname for user-uploaded HTML. It routes to the same Worker but
# never serves the application, API, webhooks, or SPA assets.
HOST_DOMAIN=files.example.com
# Both default to DOMAIN; set them only when the Worker serves from a subdomain
# of the domain it handles mail for. With DOMAIN=drop.example.com:
#MAIL_DOMAIN=example.com
#ZONE_NAME=example.com
# Optional, temporary compatibility for pre-token relay reply addresses. New
# deployments should leave this unset. Existing deployments may use an absolute
# ISO-8601 cutoff, for example: 2027-02-01T00:00:00Z
#RELAY_LEGACY_REPLY_UNTIL=
# Brand/display name shown across the web UI + CLI.
BRAND=Agent Drop
# Cloudflare account the Worker deploys to (wrangler reads CLOUDFLARE_ACCOUNT_ID).
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
# D1 database UUID for the DB binding.
D1_DATABASE_ID=your-d1-database-id

# --- AWS SES (eu-central-1): dead fallback, kept as a revert path ---
# All outbound mail goes through the Cloudflare Email Sending binding. These
# only matter if sendRawEmail in src/lib/relay.ts is ever wired back in.
# IAM user agent-drop-ses, SES send only
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=your-ses-secret-access-key

# --- Admin + API auth ---
# Full admin access to all API endpoints (manage keys, users, targets)
ADMIN_API_KEY=your-admin-api-key
# A generated API key with admin permissions (created via POST /api/keys)
API_KEY=ad_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Cloudflare R2 (presigned upload/download URLs) ---
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# --- Google OAuth (web sign-in) ---
# OAuth 2.0 client ID for the "Sign in with Google" button. Public, safe to expose.
# This is the ONLY Google credential the Worker needs -- sign-in is verified
# against Google's JWKS, so there is no client secret in the request path.
# The `client_secret_*.json` that the Cloud Console hands out lives OUTSIDE this
# repo, in passage: `key projects/agent-drop/google-oauth-client.json` prints it
# (`key-set -r projects/agent-drop/google-oauth-client.json < file.json` replaces
# it). `client_secret_*.json` stays in .gitignore so a fresh download into the
# working dir still cannot be committed.
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
