# Agent Drop — environment variables
# Copy to `.env` and fill in real values. `.env` is gitignored; never commit it.
# All vars except API_KEY are also set as Wrangler secrets on the Worker
# (`wrangler secret put <NAME>`).

# --- Deployment identity (single source of truth) ---
# `bun run deploy` injects these into wrangler (--var / --route); the Vite build
# reads DOMAIN + BRAND for the web UI. Nothing here is hardcoded in the repo.
# Apex domain the Worker serves + emails from. Route becomes "$DOMAIN/*".
DOMAIN=example.com
# Brand/display name shown across the web UI + CLI.
BRAND=Agent Drop
# Cloudflare account the Worker deploys to (wrangler reads CLOUDFLARE_ACCOUNT_ID).
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
# D1 database UUID for the DB binding.
D1_DATABASE_ID=your-d1-database-id

# --- AWS SES (outbound email, eu-central-1) ---
# IAM user agent-drop-ses, SES send only
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=your-ses-secret-access-key

# --- Admin + API auth ---
# Full admin access to all API endpoints (manage keys, users, targets)
ADMIN_API_KEY=your-admin-api-key
# A generated API key with admin permissions (created via POST /api/keys)
API_KEY=ad_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Cloudflare R2 (presigned upload/download URLs) ---
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# --- Cloudflare Email Service — REST API token (Email Sending, public beta) ---
CF_EMAIL_API_TOKEN=cfut_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Google OAuth (web sign-in) ---
# OAuth 2.0 client ID for the "Sign in with Google" button. Public, safe to expose.
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
