{
  "name": "agent-drop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:worker": "wrangler dev",
    "build": "vite build",
    "deploy": "vite build && bun scripts/deploy.ts",
    "test": "bun test",
    "types": "wrangler types --include-env false ./worker-configuration.d.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tools/tsconfig.json",
    "check": "bun run types && bun run typecheck && bun test",
    "verify": "bun run check && bunx vite build && bun scripts/deploy.ts --dry-run --outdir .claude/temp/dryrun",
    "db:migrate": "wrangler d1 execute agent-drop-db --file=migrations/0001_initial.sql"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "postal-mime": "^2.7.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "bun-types": "^1.3.14",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "wrangler": "^4.118.0",
    "yaml": "^2.9.0"
  }
}
