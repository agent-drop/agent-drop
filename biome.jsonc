{
	"$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		// *.css is excluded because Biome's CSS parser rejects Tailwind v4
		// at-rules (@theme, @plugin, @custom-variant) as syntax errors.
		// `assets` is excluded because it holds exported design artifacts -- icon
		// SVGs with embedded C2PA metadata blobs, logos, fonts -- not source. Biome
		// applied `a11y/noSvgWithoutTitle` to them and turned `bun run check` red
		// over three icon candidates that are never rendered inline anywhere.
		"includes": [
			"**",
			"!web/dist",
			"!.claude",
			"!assets",
			"!worker-configuration.d.ts",
			"!bun.lock",
			"!**/*.css"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"trailingCommas": "all",
			"semicolons": "always"
		}
	},
	"json": {
		"formatter": {
			"indentStyle": "tab"
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": {
				"noNonNullAssertion": "off",
				"useNamingConvention": "off"
			},
			"suspicious": {
				"noExplicitAny": "off"
			}
		}
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "off"
			}
		}
	}
}
